<script>
/* ================= helpers ================= */
const C={navy:'#112743',lime:'#C4D54B',pale:'#99ACFF',blue:'#2361B4',orange:'#EC704A',green:'#00A787',off:'#EBEBEB'};
const pd=s=>{const[y,m]=s.split('-').map(Number);return new Date(y,m-1,1)};
function rng(seed){return function(){seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function hash(s){let h=2166136261;for(const c of s){h^=c.charCodeAt(0);h=Math.imul(h,16777619)}return h>>>0}
function monthly(keys){const out=[];for(let i=0;i<keys.length-1;i++){const a=pd(keys[i][0]),b=pd(keys[i+1][0]);const n=(b.getFullYear()-a.getFullYear())*12+b.getMonth()-a.getMonth();for(let k=0;k<n;k++)out.push({d:new Date(a.getFullYear(),a.getMonth()+k,1),v:keys[i][1]+(keys[i+1][1]-keys[i][1])*k/n,k:k===0})}const l=keys[keys.length-1];out.push({d:pd(l[0]),v:l[1],k:true});return out}
function jitter(s,amp,seed,dp){const r=rng(seed);let n=0;return s.map((p,i)=>{n=n*.55+(r()-.5)*amp;let v=p.k?p.v:p.v+n;if(dp!=null)v=+v.toFixed(dp);return{d:p.d,v}})}
const every=(s,k)=>s.filter((p,i)=>(s.length-1-i)%k===0);
const last=s=>s[s.length-1];
function at(s,d){let best=s[0];for(const p of s)if(Math.abs(p.d-d)<Math.abs(best.d-d))best=p;return best}
function yoy(s){const l=last(s);const p=at(s,new Date(l.d.getFullYear()-1,l.d.getMonth(),1));return(l.v/p.v-1)*100}
function cagr(s,a,b){const p0=at(s,pd(a)),p1=b?at(s,pd(b)):last(s);const yrs=(p1.d-p0.d)/(365.25*864e5);return(Math.pow(p1.v/p0.v,1/yrs)-1)*100}
const f1=d3.format('.1f'),fc=d3.format(',.0f');
const sgn=v=>(v>0?'+':v<0?'−':'')+f1(Math.abs(v));

/* ================= national data (illustrative history, ONS headline end points) ================= */
const D={};
D.unemp=jitter(monthly([['2020-01',3.9],['2020-03',4.1],['2020-06',4.1],['2020-09',4.8],['2020-11',5.2],['2021-01',5.1],['2021-06',4.8],['2021-12',4.0],['2022-03',3.8],['2022-07',3.6],['2022-12',3.8],['2023-06',4.3],['2023-12',4.0],['2024-04',4.4],['2024-09',4.2],['2025-02',4.4],['2025-07',4.7],['2025-10',5.1],['2025-12',5.2],['2026-03',5.0],['2026-05',4.9],['2026-07',4.9]]),.14,1,1);
D.unempF=monthly([['2025-12',5.2],['2026-06',5.3],['2027-06',4.9],['2028-06',4.4],['2029-06',4.2],['2030-06',4.1]]);
D.vac=jitter(monthly([['2017-01',760],['2018-06',840],['2019-06',820],['2020-01',800],['2020-05',340],['2020-12',600],['2021-06',900],['2022-05',1300],['2023-01',1120],['2023-12',930],['2024-06',880],['2025-01',800],['2025-08',738],['2026-01',718],['2026-08',702]]),14,2,0);
D.uv=jitter(monthly([['2015-01',2.6],['2016-01',2.2],['2017-01',2.0],['2018-01',1.7],['2019-01',1.6],['2019-12',1.6],['2020-08',4.1],['2021-06',1.8],['2022-06',0.9],['2023-01',1.1],['2024-01',1.6],['2025-01',2.0],['2025-08',2.5],['2026-07',2.5]]),.06,3,1);
D.wage=jitter(monthly([['2000-01',568],['2002-06',605],['2004-06',630],['2006-06',652],['2008-01',676],['2009-06',668],['2011-06',645],['2014-03',616],['2016-01',645],['2019-01',650],['2020-01',660],['2020-05',650],['2021-03',688],['2022-06',655],['2023-01',652],['2024-01',672],['2025-01',687],['2025-07',689],['2026-01',691],['2026-07',694.5]]),3.2,4,1);
D.wageF=monthly([['2026-07',694.5],['2027-01',702],['2028-01',704],['2029-01',706],['2030-06',709]]);
D.cpi={
  all:jitter(monthly([['2019-01',106.5],['2021-01',109.4],['2022-10',124.3],['2023-10',129.5],['2024-10',132.3],['2025-08',139.3],['2026-08',143.6]]),.25,5,1),
  food:jitter(monthly([['2019-01',104],['2021-01',106],['2022-10',128],['2023-03',140],['2024-08',148],['2025-08',154],['2026-08',156]]),.5,6,1),
  energy:jitter(monthly([['2019-01',112],['2021-09',122],['2022-10',220],['2023-06',200],['2024-04',165],['2025-08',171.5],['2026-08',181.8]]),2,7,1),
  fuel:jitter(monthly([['2019-01',108],['2020-05',95],['2022-07',160],['2023-06',130],['2025-08',125],['2026-03',140],['2026-08',153.8]]),2.2,8,1)
};
D.gdp=every(jitter(monthly([['2000-01',521],['2008-01',626],['2009-06',588],['2011-01',610],['2013-01',625],['2016-01',670],['2019-10',706],['2020-04',560],['2020-10',660],['2021-10',700],['2022-10',712],['2023-10',716],['2024-10',726],['2025-06',734],['2025-10',737],['2026-06',744.5]]),2,9,1),3);
D.prod=every(jitter(monthly([['2000-01',78],['2008-01',92],['2009-06',89],['2013-01',92],['2016-01',95],['2019-10',97.5],['2020-04',94],['2021-06',98.5],['2023-06',100],['2025-06',100.2],['2026-06',101.6]]),.35,10,1),3);
// MHCLG published 12-month rolling new build starts, England (thousands)
D.starts=[['2007-12',183.6],['2009-06',75.35],['2018-09',169.2],['2020-03',148.52],['2020-09',123.03],['2023-06',192.21],['2024-06',90.81],['2025-03',113.19],['2026-03',130.17]].map(([d,v])=>({d:pd(d),v}));
const STARTS_Q2_2026=35910;
const UNEMPLOYED=1778, VACANCIES=702, UV_NOW=UNEMPLOYED/VACANCIES;

/* ================= charts ================= */
const tt=document.getElementById('tt');
function showTT(e,html){tt.innerHTML=html;tt.classList.remove('hidden');const x=Math.min(e.clientX+14,innerWidth-250);tt.style.left=x+'px';tt.style.top=(e.clientY+14)+'px'}
function hideTT(){tt.classList.add('hidden')}

function lineChart(el,cfg){
  el.innerHTML='';
  const W=Math.max(el.clientWidth,200),H=cfg.height||230,m={t:14,r:cfg.r??18,b:24,l:cfg.l??40};
  const svg=d3.select(el).append('svg').attr('width',W).attr('height',H).attr('role','img').attr('aria-label',cfg.aria||'');
  const all=cfg.series.filter(s=>!s.hidden).flatMap(s=>s.data);
  if(!all.length)return;
  const x=d3.scaleTime().domain(cfg.x||d3.extent(all,d=>d.d)).range([m.l,W-m.r]);
  let ext=d3.extent(all,d=>d.v);const pad=(ext[1]-ext[0])*.08;
  const y=d3.scaleLinear().domain(cfg.y||[ext[0]-pad,ext[1]+pad]).nice(5).range([H-m.b,m.t]);
  (cfg.bands||[]).forEach(b=>{
    if(b.y){svg.append('rect').attr('x',m.l).attr('width',W-m.l-m.r).attr('y',y(b.y[1])).attr('height',y(b.y[0])-y(b.y[1])).attr('fill',b.c||C.green).attr('opacity',.18)}
    if(b.x){const x0=x(pd(b.x[0])),x1=x(pd(b.x[1]));svg.append('rect').attr('x',x0).attr('width',x1-x0).attr('y',m.t).attr('height',H-m.b-m.t).attr('fill','#fff').attr('opacity',.06)}
    if(b.label)svg.append('text').attr('x',b.x?x(pd(b.x[0]))+5:m.l+5).attr('y',b.x?m.t+12:y(b.y[1])+13).attr('text-anchor','start').attr('fill',b.y?C.green:'#9fb2cc').attr('font-size',11).attr('font-weight',600).text(b.label);
  });
  const yt=y.ticks(cfg.yTicks||5);
  svg.append('g').selectAll('line').data(yt).join('line').attr('x1',m.l).attr('x2',W-m.r).attr('y1',y).attr('y2',y).attr('stroke','rgba(255,255,255,.1)');
  svg.append('g').selectAll('text').data(yt).join('text').attr('x',m.l-7).attr('y',d=>y(d)+4).attr('text-anchor','end').attr('fill','#9fb2cc').attr('font-size',11).text(cfg.yf||(d=>d));
  const yrs=(x.domain()[1]-x.domain()[0])/(365.25*864e5);
  const step=yrs>20?4:yrs>9?2:1;
  const xt=x.ticks(d3.timeYear.every(step));
  svg.append('g').selectAll('text').data(xt).join('text').attr('x',x).attr('y',H-6).attr('text-anchor','middle').attr('fill','#9fb2cc').attr('font-size',11).text(d3.timeFormat('%Y'));
  svg.append('line').attr('x1',m.l).attr('x2',W-m.r).attr('y1',H-m.b).attr('y2',H-m.b).attr('stroke','rgba(255,255,255,.35)');
  const line=d3.line().x(d=>x(d.d)).y(d=>y(d.v)).curve(d3.curveMonotoneX);
  cfg.series.filter(s=>!s.hidden).forEach(s=>{
    svg.append('path').datum(s.data).attr('d',s.points?d3.line().x(d=>x(d.d)).y(d=>y(d.v))(s.data):line).attr('fill','none').attr('stroke',s.c).attr('stroke-width',s.w||2.6).attr('stroke-dasharray',s.dash?'5 5':null).attr('stroke-linejoin','round');
    if(s.points)svg.append('g').selectAll('circle').data(s.data.slice(0,-1)).join('circle').attr('cx',d=>x(d.d)).attr('cy',d=>y(d.v)).attr('r',3.2).attr('fill',s.c);
    if(s.label){const l=s.labelAt?at(s.data,pd(s.labelAt)):last(s.data);svg.append('text').attr('x',Math.min(x(l.d),W-m.r)).attr('y',y(l.v)+(s.labelDy||-10)).attr('text-anchor','end').attr('fill',s.c).attr('font-size',11.5).attr('font-weight',700).text(s.label)}
  });
  const live=cfg.series.filter(s=>s.live&&!s.hidden);
  live.forEach(s=>{const l=last(s.data);const g=svg.append('g');
    g.append('circle').attr('class','pulse').attr('cx',x(l.d)).attr('cy',y(l.v)).attr('r',5).attr('fill',s.dot||C.lime);
    g.append('circle').attr('cx',x(l.d)).attr('cy',y(l.v)).attr('r',5).attr('fill',s.dot||C.lime).attr('stroke',C.navy).attr('stroke-width',1.5);});
  // hover
  const main=cfg.series.find(s=>!s.hidden&&!s.dash);
  if(main&&!cfg.noHover){
    const hl=svg.append('line').attr('y1',m.t).attr('y2',H-m.b).attr('stroke','rgba(255,255,255,.35)').style('display','none');
    const fmt=d3.timeFormat(cfg.df||'%b %Y');
    svg.append('rect').attr('x',m.l).attr('y',m.t).attr('width',W-m.l-m.r).attr('height',H-m.t-m.b).attr('fill','transparent')
      .on('mousemove',e=>{const d=x.invert(d3.pointer(e)[0]);hl.style('display',null).attr('x1',x(at(main.data,d).d)).attr('x2',x(at(main.data,d).d));
        const rows=cfg.series.filter(s=>!s.hidden).map(s=>{const p=at(s.data,d);return Math.abs(p.d-d)<1e10?`<div><span style="color:${s.c==='#fff'?C.navy:s.c};font-weight:800">●</span> ${s.name||''} ${(cfg.tf||cfg.yf||(v=>v))(p.v)}</div>`:''}).join('');
        showTT(e,`<b>${fmt(at(main.data,d).d)}</b>${rows}`)})
      .on('mouseleave',()=>{hl.style('display','none');hideTT()});
  }
}

function periodBars(el,rows,fmt){
  const vs=rows.map(r=>r.v);const lo=Math.min(0,d3.min(vs)),hi=Math.max(0,d3.max(vs))*1.08;const sp=hi-lo||1;
  el.innerHTML=rows.map(r=>{const left=(Math.min(0,r.v)-lo)/sp*100,w=Math.abs(r.v)/sp*100;
    return `<div class="pb-row ${r.now?'now':''}"><div class="pb-l">${r.label}</div><div class="pb-t"><div class="pb-z" style="left:${(0-lo)/sp*100}%"></div><div class="pb-b" style="left:${left}%;width:${Math.max(w,.6)}%"></div></div><div class="pb-v">${(fmt||sgn)(r.v)}%</div></div>`}).join('');
}

function dial(el,v){
  el.innerHTML='';
  const W=Math.max(el.clientWidth,260),H=Math.min(W*.66,290),cx=W/2,cy=H-46,R=Math.min(W/2-26,H-64),r0=R*.6,min=0,max=4;
  const svg=d3.select(el).append('svg').attr('width',W).attr('height',H).attr('role','img').attr('aria-label',`Dial showing ${f1(v)} unemployed people per vacancy`);
  const ang=t=>-Math.PI/2+(Math.min(Math.max(t,min),max)-min)/(max-min)*Math.PI;
  const segs=[{a:0,b:1.5,c:C.blue,l:'Too few workers'},{a:1.5,b:2.5,c:'#dfe5ff',l:''},{a:2.5,b:4,c:C.orange,l:'Too few jobs'}];
  const arc=d3.arc().innerRadius(r0).outerRadius(R).padAngle(.012);
  const g=svg.append('g').attr('transform',`translate(${cx},${cy})`);
  segs.forEach(s=>{g.append('path').attr('d',arc({startAngle:ang(s.a),endAngle:ang(s.b)})).attr('fill',s.c);
    if(s.l){const mA=(ang(s.a)+ang(s.b))/2,rr=(R+r0)/2;const px=Math.sin(mA)*rr,py=-Math.cos(mA)*rr;
      g.append('text').attr('transform',`translate(${px},${py}) rotate(${mA*180/Math.PI+(mA<0?0:0)})`).attr('text-anchor','middle').attr('dy','.35em').attr('fill','#fff').attr('font-weight',800).attr('font-size',Math.max(10,R*.085)).text(s.l)}});
  const mB=ang(2),rb=(R+r0)/2;
  g.append('text').attr('x',Math.sin(mB)*rb).attr('y',-Math.cos(mB)*rb).attr('dy','.35em').attr('text-anchor','middle').attr('fill',C.navy).attr('font-weight',800).attr('font-size',Math.max(10,R*.09)).text('Balanced');
  [0,1.5,2.5,4].forEach(t=>{const a=ang(t);g.append('text').attr('x',Math.sin(a)*(R+13)).attr('y',-Math.cos(a)*(R+13)+4).attr('text-anchor','middle').attr('fill','#9fb2cc').attr('font-size',11).text(t)});
  const nd=g.append('g').attr('transform',`rotate(${ang(min)*180/Math.PI})`);
  nd.append('path').attr('d',`M-4,0 L0,${-(R+4)} L4,0 Z`).attr('fill','#fff');
  nd.transition().duration(1300).ease(d3.easeCubicOut).attr('transform',`rotate(${ang(v)*180/Math.PI})`);
  g.append('circle').attr('r',9).attr('fill','#fff');g.append('circle').attr('r',4).attr('fill',C.navy);
  g.append('circle').attr('class','pulse').attr('cy',34).attr('cx',-34).attr('r',5).attr('fill',C.lime);
  g.append('circle').attr('cy',34).attr('cx',-34).attr('r',5).attr('fill',C.lime);
  g.append('text').attr('y',44).attr('x',-22).attr('fill',C.lime).attr('font-size',30).attr('font-weight',800).text(f1(v));
}

/* ================= polling ================= */
function unit(segs){let i=0,out='';const s=11;segs.forEach(sg=>{for(let k=0;k<sg.v;k++){const r=Math.floor(i/10),c=i%10;out+=`<rect x="${c*s}" y="${r*s}" width="${s-2.5}" height="${s-2.5}" rx="2" fill="${sg.c}"/>`;i++}});return `<svg width="${10*s}" height="${10*s}" viewBox="0 0 ${10*s} ${10*s}" role="img" aria-label="${segs.map(x=>x.l+' '+x.v+'%').join(', ')}">${out}</svg>`}
function poll(id,p){
  const el=document.getElementById(id);
  el.innerHTML=`<div class="by">GGF Insights polling <span>${p.n}</span></div><div class="q">“${p.q}”</div>
  <div class="head">${unit(p.segs)}<div><div class="big ${p.good?'good':''}">${p.big}%</div><div class="bigl">${p.bigl}</div></div></div>
  <ul class="leg">${p.segs.map(s=>`<li><span><i style="background:${s.c}"></i>${s.l}</span><b>${s.v}%</b></li>`).join('')}</ul>
  <div class="ctx">${p.ctx}</div>`;
}
const HARD=[C.orange,'#f4a98f'],NEU='#d3d8df',EASY=['#7fd0c0',C.green],DK='#eef0f3';

/* ================= render national ================= */
const rendered={};
function renderWork(){
  const u=last(D.unemp),u12=at(D.unemp,new Date(u.d.getFullYear()-1,u.d.getMonth(),1));
  document.getElementById('st-unemp').innerHTML=`<div class="stat lead"><b>${f1(u.v)}%</b><span>May to July 2026</span></div><div class="stat"><b>${sgn(u.v-u12.v)}pp</b><span>change on a year ago</span></div><div class="stat"><b>5.3%</b><span>OBR forecast for 2026</span></div>`;
  lineChart(document.getElementById('ch-unemp'),{series:[{data:D.unempF,c:C.pale,dash:true,w:2,label:'OBR forecast',labelAt:'2028-09',labelDy:-12,name:'OBR'},{data:D.unemp,c:C.lime,live:true,name:'Unemployment'}],x:[pd('2020-01'),pd('2030-06')],y:[3,6],yf:d=>d+'%',tf:v=>f1(v)+'%',aria:'Unemployment rate 2020 to 2026 with OBR forecast to 2030'});
  const v=last(D.vac),v12=at(D.vac,new Date(v.d.getFullYear()-1,v.d.getMonth(),1)),pk=d3.max(D.vac,d=>d.v);
  document.getElementById('st-vac').innerHTML=`<div class="stat lead"><b>${fc(v.v)}k</b><span>June to August 2026</span></div><div class="stat"><b>${sgn((v.v/v12.v-1)*100)}%</b><span>change on a year ago</span></div><div class="stat"><b>${sgn((v.v/pk-1)*100)}%</b><span>since the 2022 peak</span></div>`;
  lineChart(document.getElementById('ch-vac'),{series:[{data:D.vac,c:C.lime,live:true,name:'Vacancies'}],y:[0,1400],yf:d=>d===0?'0':fc(d)+'k',tf:v=>fc(v)+'k',aria:'Vacancies 2017 to 2026'});
  dial(document.getElementById('ch-dial'),UV_NOW);
  lineChart(document.getElementById('ch-uv'),{height:200,series:[{data:D.uv,c:C.lime,live:true,name:'Ratio'}],y:[0,4.5],bands:[{y:[1.5,2.5],label:'Balanced'}],tf:v=>f1(v),aria:'Unemployed per vacancy since 2015'});
  poll('poll-job',{q:'How hard is it to find a job at the moment?',big:64,bigl:'say it is hard to find a job',segs:[{l:'Very hard',v:26,c:HARD[0]},{l:'Fairly hard',v:38,c:HARD[1]},{l:'Neither',v:16,c:NEU},{l:'Fairly easy',v:13,c:EASY[0]},{l:'Very easy',v:4,c:EASY[1]},{l:"Don't know",v:3,c:DK}],
    ctx:`Unemployment, at <strong>${f1(u.v)}%</strong>, is below what the OBR expected. Two in three people still find the job market hard going.`,n:'2,000 adults, Sep 2026'});
  poll('poll-emp',{q:'How hard is it to find an employee at the moment?',big:61,bigl:'of employers say hiring is hard',segs:[{l:'Very hard',v:22,c:HARD[0]},{l:'Fairly hard',v:39,c:HARD[1]},{l:'Neither',v:20,c:NEU},{l:'Fairly easy',v:11,c:EASY[0]},{l:'Very easy',v:3,c:EASY[1]},{l:"Don't know",v:5,c:DK}],
    ctx:`There are <strong>${fc(v.v)}k</strong> vacancies, the fewest since 2021, yet most employers still struggle to fill them.`,n:'500 employers, Sep 2026'});
  document.getElementById('poll-gap').innerHTML=`<div class="by">Reading the polls together</div><div class="q">Both sides of the market say it is hard</div>
    <div class="bigl" style="margin-bottom:4px">Job seekers who say finding work is hard</div><div class="gapbar"><div style="width:64%;background:${C.orange}"></div></div>
    <div class="bigl" style="margin-bottom:4px">Employers who say hiring is hard</div><div class="gapbar"><div style="width:61%;background:${C.blue}"></div></div>
    <div class="ctx">With <strong>${f1(UV_NOW)}</strong> people looking for every vacancy, the dial says jobs are scarce. Employers struggling to hire at the same time points to a mismatch of skills and place, not only a shortage of jobs.</div>`;
