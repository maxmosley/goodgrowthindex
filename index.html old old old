<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Good Growth Tracker | Good Growth Foundation</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.js"></script>
<style>
:root{
  --navy:#112743; --navy2:#16314f; --navy3:#1d3a5e; --blue:#2361B4; --lime:#C4D54B; --pale:#99ACFF;
  --green:#00A787; --orange:#EC704A; --off:#EBEBEB;
  --ink:#0c1c33; --paper:#eef1f3; --line:#dde2e8; --muted:#5d6b7e;
  --onNavy:#e9eef6; --onNavyMuted:#9fb2cc; --navyLine:rgba(255,255,255,.12);
  --font:'Manrope',Inter,Arial,sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{font-family:var(--font);background:var(--paper);color:var(--ink);line-height:1.5;-webkit-font-smoothing:antialiased}
button{font-family:var(--font)}
:focus-visible{outline:3px solid var(--pale);outline-offset:2px}
.hidden{display:none!important}

/* banner */
.banner{background:var(--navy);color:#fff;display:flex;align-items:center;gap:28px;padding:18px 32px;flex-wrap:wrap}
.wm{font-weight:700;font-size:1.02rem;line-height:1.02;letter-spacing:-.01em}
.banner .rule{width:1px;align-self:stretch;background:var(--navyLine)}
.banner h1{margin:0;font-size:1.6rem;font-weight:800;letter-spacing:-.02em;line-height:1.1}
.banner p{margin:3px 0 0;color:var(--onNavyMuted);font-size:.92rem}
.banner .meta{margin-left:auto;display:flex;align-items:center;gap:9px;color:var(--onNavy);font-size:.82rem;font-weight:600}
.live{width:9px;height:9px;border-radius:50%;background:var(--lime);position:relative;display:inline-block}
.live::after{content:"";position:absolute;inset:0;border-radius:50%;background:var(--lime);animation:ring 2s ease-out infinite}
@keyframes ring{0%{transform:scale(1);opacity:.7}100%{transform:scale(3.2);opacity:0}}
.proto{background:var(--lime);color:var(--navy);font-size:.78rem;font-weight:700;text-align:center;padding:6px 16px}

/* layout */
.layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:24px;padding:24px 32px 40px;max-width:1680px;margin:0 auto}
.tabs{display:flex;gap:6px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:6px;margin-bottom:18px}
.tab{flex:1;border:none;background:transparent;border-radius:10px;padding:10px 14px;min-height:62px;display:flex;align-items:center;text-align:left;cursor:pointer;color:var(--ink)}
.tab .tn{display:block;font-weight:800;font-size:.98rem}
.tab:hover{background:var(--paper)}
.tab[aria-selected="true"]{background:var(--navy);color:#fff}
.colheads{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:26px;margin:0 2px 8px;font-size:.8rem;font-weight:700;color:var(--muted)}
.colheads span:last-child{color:var(--blue)}

.row{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:26px;margin-bottom:22px;align-items:start}
.panel{background:var(--navy);color:var(--onNavy);border-radius:16px;box-shadow:0 10px 30px rgba(17,39,67,.16)}
.ind{padding:20px 22px 14px}
.ind h3{margin:0;font-size:1.22rem;font-weight:800;color:#fff;letter-spacing:-.01em;line-height:1.25;max-width:46ch}
.ind .sub{font-size:.84rem;color:var(--onNavyMuted);margin-top:3px}
.stats{display:flex;flex-wrap:wrap;gap:8px 26px;margin:14px 0 6px}
.stat b{display:block;font-size:1.55rem;font-weight:800;color:#fff;letter-spacing:-.02em;line-height:1.1}
.stat span{font-size:.76rem;color:var(--onNavyMuted);font-weight:600}
.stat.lead b{color:var(--lime)}
.chart{width:100%;min-height:220px;position:relative}
.src{font-size:.7rem;color:var(--onNavyMuted);margin:8px 0 0}
.split{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:22px;align-items:start}
.split h4{margin:6px 0 10px;font-size:.84rem;color:var(--onNavy);font-weight:700}

/* period bars */
.pb-row{display:grid;grid-template-columns:96px minmax(0,1fr) 54px;gap:10px;align-items:center;margin-bottom:11px}
.pb-l{font-size:.76rem;color:var(--onNavyMuted);font-weight:600;line-height:1.2}
.pb-t{position:relative;height:22px;background:rgba(255,255,255,.05);border-radius:4px}
.pb-z{position:absolute;top:-3px;bottom:-3px;width:1px;background:rgba(255,255,255,.4)}
.pb-b{position:absolute;top:0;bottom:0;border-radius:3px;background:var(--pale);opacity:.55}
.pb-row.now .pb-b{background:var(--lime);opacity:1}
.pb-row.now .pb-l{color:#fff}
.pb-v{font-size:.9rem;font-weight:800;color:#fff;text-align:right}
.pb-row.now .pb-v{color:var(--lime)}

/* chips */
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 4px}
.chip{border:1px solid var(--navyLine);border-radius:10px;padding:7px 11px;background:rgba(255,255,255,.04);cursor:pointer;color:var(--onNavy);text-align:left}
.chip i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:7px;vertical-align:-1px}
.chip b{font-size:1.05rem;font-weight:800;color:#fff;margin-left:4px}
.chip[aria-pressed="false"]{opacity:.4}

/* polling */
.poll{position:relative;background:#fff;border-radius:14px;border-left:5px solid var(--pale);padding:16px 16px 14px;box-shadow:0 6px 18px rgba(17,39,67,.07)}
.poll::before{content:"";position:absolute;left:-31px;top:44px;width:26px;height:2px;background:var(--pale)}
.poll::after{content:"";position:absolute;left:-35px;top:41px;width:8px;height:8px;border-radius:50%;background:var(--lime);border:2px solid var(--navy)}
.poll .by{font-size:.74rem;font-weight:800;color:var(--blue)}
.poll .by{padding-right:36px}
.poll .by span{font-weight:600;color:var(--muted);margin-left:4px;white-space:nowrap}
.poll .q{font-size:1rem;font-weight:700;color:var(--navy);margin:4px 0 10px;line-height:1.3}
.poll .head{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.poll .big{font-size:2.2rem;font-weight:800;color:var(--orange);letter-spacing:-.03em;line-height:1}
.poll .big.good{color:var(--green)}
.poll .bigl{font-size:.82rem;font-weight:600;color:var(--ink);line-height:1.25}
.poll .leg{list-style:none;padding:0;margin:8px 0 0;font-size:.74rem;color:var(--muted);display:grid;grid-template-columns:1fr 1fr;column-gap:12px}
.poll .leg li{display:flex;justify-content:space-between;gap:6px;padding:1px 0}
.poll .leg i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:6px;vertical-align:-1px}
.poll .leg b{color:var(--ink)}
.poll .ctx{border-top:1px solid var(--line);margin-top:10px;padding-top:9px;font-size:.84rem;color:var(--ink);line-height:1.45}
.poll .ctx strong{color:var(--navy)}
.poll .n{font-size:.68rem;color:var(--muted);margin-top:8px}
.poll.empty{border-left-color:var(--line);background:#f7f8fa}
.poll.empty .q{color:var(--muted)}
.gapbar{display:flex;height:10px;border-radius:5px;overflow:hidden;background:var(--off);margin:4px 0 10px}

/* regional */
.regional{position:sticky;top:16px;height:calc(100vh - 32px);min-height:640px;display:flex;flex-direction:column;padding:20px 20px 16px;overflow:hidden}
.regional h2{margin:0 0 12px;font-size:1.22rem;font-weight:800;color:#fff;letter-spacing:-.01em}
.regional .sub{font-size:.84rem;color:var(--onNavyMuted);margin:3px 0 12px}
.search{display:flex;gap:6px;background:#fff;border-radius:11px;padding:5px}
.search input{flex:1;min-width:0;border:none;outline:none;font-family:var(--font);font-size:.92rem;padding:8px 10px;color:var(--ink)}
.search button{border:none;background:var(--blue);color:#fff;font-weight:700;border-radius:8px;padding:0 14px;cursor:pointer;font-size:.84rem}
.mapbox{flex:1;min-height:240px;position:relative;margin:10px 0}
.mapbox svg{width:100%;height:100%;display:block}
.mapbox path{stroke:var(--navy);stroke-width:.4;vector-effect:non-scaling-stroke;cursor:pointer}
.mapbox path:hover{stroke:#fff;stroke-width:1.2}
.mapbox path.sel{stroke:var(--lime);stroke-width:2.6}
.mapmsg{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:20px;color:var(--onNavyMuted);font-size:.86rem}
.mapctl{position:absolute;right:4px;top:4px;display:flex;flex-direction:column;gap:4px}
.mapctl button{width:30px;height:30px;border-radius:8px;border:1px solid var(--navyLine);background:var(--navy2);color:#fff;font-weight:800;cursor:pointer}
.cycler{display:flex;align-items:center;gap:8px}
.cycler button{width:34px;height:34px;flex:none;border-radius:9px;border:1px solid var(--navyLine);background:var(--navy2);color:#fff;font-size:1rem;cursor:pointer}
.cycler button:hover{background:var(--navy3)}
.cycler .cn{flex:1;text-align:center}
.cycler .cn b{display:block;color:#fff;font-size:.95rem;font-weight:800}
.cycler .cn span{font-size:.72rem;color:var(--onNavyMuted)}
.regional .cycler .cn span{display:none}
.legend{margin:10px 0 0}
.legend .sw{display:flex;height:9px;border-radius:5px;overflow:hidden}
.legend .sw i{flex:1}
.legend .ll{display:flex;justify-content:space-between;font-size:.7rem;color:var(--onNavyMuted);margin-top:4px;font-weight:600}
.selcard{margin-top:12px;border-top:1px solid var(--navyLine);padding-top:12px;font-size:.84rem;color:var(--onNavyMuted);min-height:70px}
.selcard .nm{color:#fff;font-weight:800;font-size:1.05rem}
.selcard .val{font-size:1.7rem;font-weight:800;color:var(--lime);letter-spacing:-.02em;line-height:1.15}
.selcard .cmp{font-weight:600}
.explore-btn{margin-top:12px;border:none;background:var(--lime);color:var(--navy);font-weight:800;font-size:.95rem;border-radius:11px;padding:12px;cursor:pointer}
.explore-btn:hover{filter:brightness(1.06)}

/* tooltip */
.tt{position:fixed;pointer-events:none;z-index:200;background:#fff;color:var(--ink);border-radius:9px;padding:7px 10px;font-size:.8rem;box-shadow:0 8px 24px rgba(0,0,0,.3);max-width:240px}
.tt b{display:block;color:var(--navy)}

/* explore */
.explore{position:fixed;inset:0;z-index:100;background:var(--navy);color:var(--onNavy);display:grid;grid-template-rows:auto minmax(0,1fr)}
.ex-top{display:flex;align-items:center;gap:18px;padding:14px 24px;border-bottom:1px solid var(--navyLine);flex-wrap:wrap}
.ex-top h2{margin:0;font-size:1.25rem;font-weight:800;color:#fff}
.ex-top .search{width:min(360px,100%);margin-left:auto}
.ex-close{border:1px solid var(--navyLine);background:var(--navy2);color:#fff;border-radius:10px;padding:9px 14px;font-weight:700;cursor:pointer}
.ex-body{display:grid;grid-template-columns:minmax(0,1fr) 400px;min-height:0}
.ex-body .mapbox{margin:14px 0 14px 18px}
.ex-side{border-left:1px solid var(--navyLine);overflow-y:auto;padding:18px 22px 30px}
.indlist{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0 14px}
.indlist button{border:1px solid var(--navyLine);background:transparent;color:var(--onNavy);border-radius:20px;padding:5px 11px;font-size:.76rem;font-weight:600;cursor:pointer}
.indlist button[aria-pressed="true"]{background:var(--pale);color:var(--navy);border-color:var(--pale);font-weight:800}
.ex-side h3{margin:18px 0 8px;font-size:.88rem;color:#fff;font-weight:800}
.ex-desc{font-size:.84rem;color:var(--onNavyMuted);margin:8px 0 0}
.areatab{width:100%;border-collapse:collapse;font-size:.8rem}
.areatab td{padding:6px 4px;border-bottom:1px solid var(--navyLine)}
.areatab td:nth-child(2),.areatab td:nth-child(3){text-align:right;font-weight:700;white-space:nowrap}
.areatab td:nth-child(2){color:#fff}
.areatab td:nth-child(3){color:var(--onNavyMuted);font-weight:600}
.areatab tr.cur td{color:var(--lime)}
.areatab tr{cursor:pointer}
.rank{list-style:none;padding:0;margin:0;font-size:.8rem}
.rank li{display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--navyLine);cursor:pointer}
.rank li:hover{color:#fff}
.rank li b{color:#fff}
.two{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.spark{min-height:130px}
.note{font-size:.72rem;color:var(--onNavyMuted);margin-top:16px;line-height:1.45}


/* download as image */
.ind,.poll,.regional{position:relative}
.dl{position:absolute;top:12px;right:12px;width:30px;height:30px;border-radius:8px;border:1px solid var(--navyLine);background:rgba(255,255,255,.06);color:var(--onNavyMuted);cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;z-index:3}
.dl:hover{color:#fff;background:rgba(255,255,255,.14)}
.poll .dl{border-color:var(--line);background:#fff;color:var(--muted)}
.poll .dl:hover{color:var(--navy);background:var(--paper)}
.ind h3{padding-right:40px}
.exporting .pulse{animation:none;opacity:0}
.exporting{box-shadow:none!important}
/* chart svg */
.pulse{transform-box:fill-box;transform-origin:center;animation:ring 2s ease-out infinite}
@media (prefers-reduced-motion:reduce){.pulse,.live::after{animation:none;opacity:0}}

@media (max-width:1180px){
  .layout{grid-template-columns:1fr}
  .regional{position:relative;top:0;height:720px}
}
@media (max-width:820px){
  .layout{padding:16px}
  .banner{padding:16px}
  .row,.colheads{grid-template-columns:1fr}
  .colheads{display:none}
  .poll::before,.poll::after{display:none}
  .split{grid-template-columns:1fr}
  .tabs{flex-direction:column}
  .ex-body{grid-template-columns:1fr;grid-template-rows:55vh auto;overflow-y:auto}
  .ex-side{border-left:none;border-top:1px solid var(--navyLine)}
}
</style>
</head>
<body>

<header class="banner">
  <div class="wm" aria-label="Good Growth Foundation">Good<br>Growth<br>Foundation</div>
  <div class="rule" aria-hidden="true"></div>
  <div>
    <h1>Good Growth Tracker</h1>
    <p>A tracker to monitor how the economy is growing, and how people feel about it</p>
  </div>
  <div class="meta"><span class="live" aria-hidden="true"></span>Latest ONS releases to September 2026</div>
</header>
<div class="proto">Prototype</div>

<main class="layout">
  <section aria-label="National indicators">
    <div class="tabs" role="tablist">
      <button class="tab" role="tab" data-tab="work" aria-selected="true"><span class="tn">Work</span></button>
      <button class="tab" role="tab" data-tab="wages" aria-selected="false"><span class="tn">Wages and the cost of living</span></button>
      <button class="tab" role="tab" data-tab="growth" aria-selected="false"><span class="tn">Growth</span></button>
    </div>
    <div class="colheads"><span></span><span>What people tell us</span></div>

    <!-- WORK -->
    <div class="tabpanel" id="tab-work" role="tabpanel">
      <div class="row">
        <article class="panel ind">
          <h3><span style="color:var(--lime)">Unemployment</span> has eased back below the <span style="color:var(--pale)">OBR's forecast</span></h3>
          <div class="sub">Unemployment rate, aged 16 and over, seasonally adjusted</div>
          <div class="stats" id="st-unemp"></div>
          <div class="chart" id="ch-unemp"></div>
          <p class="src">Source: ONS Labour Market Statistics (September 2026), OBR Economic and Fiscal Outlook (March 2026). Series MGSX.</p>
        </article>
        <aside class="poll" id="poll-job"></aside>
      </div>
      <div class="row">
        <article class="panel ind">
          <h3><span style="color:var(--lime)">Job vacancies</span> have been falling for four years</h3>
          <div class="sub">Total UK vacancies, thousands, three-month average</div>
          <div class="stats" id="st-vac"></div>
          <div class="chart" id="ch-vac"></div>
          <p class="src">Source: ONS Vacancy Survey (September 2026). Series AP2Y. Excludes agriculture, forestry and fishing.</p>
        </article>
        <aside class="poll" id="poll-emp"></aside>
      </div>
      <div class="row">
        <article class="panel ind">
          <h3>Labour market demand: <span style="color:var(--lime)">2.5 people</span> are looking for work for every vacancy</h3>
          <div class="sub">Number of unemployed people per vacancy</div>
          <div class="split" style="margin-top:12px;grid-template-columns:minmax(0,1fr) minmax(0,1fr)">
            <div class="chart" id="ch-dial" style="min-height:260px"></div>
            <div><h4>Since 2015, against the balanced range</h4><div class="chart" id="ch-uv" style="min-height:200px"></div></div>
          </div>
          <p class="src">Notes: Balanced range of 1.5 to 2.5 follows NEF's labour market tracker. Source: GGF calculations using ONS Labour Market Statistics (September 2026).</p>
        </article>
        <aside class="poll" id="poll-gap"></aside>
      </div>
    </div>

    <!-- WAGES -->
    <div class="tabpanel hidden" id="tab-wages" role="tabpanel">
      <div class="row">
        <article class="panel ind">
          <h3><span style="color:var(--lime)">Real wages</span> are rising, but more slowly than before 2008</h3>
          <div class="sub">Average weekly regular pay in today's prices, against OBR projections</div>
          <div class="split" style="margin-top:12px">
            <div class="chart" id="ch-wage"></div>
            <div><h4>Average real pay growth a year</h4><div id="pb-wage"></div></div>
          </div>
          <p class="src">Notes: Whole economy regular pay deflated by CPI. Source: ONS Average Weekly Earnings (September 2026), OBR Economic and Fiscal Outlook (March 2026).</p>
        </article>
        <aside class="poll" id="poll-sol"></aside>
      </div>
      <div class="row">
        <article class="panel ind">
          <h3><span style="color:var(--orange)">Fuel</span> and <span style="color:var(--green)">energy</span> are pushing <span style="color:var(--lime)">prices</span> up again</h3>
          <div class="sub">CPI index, 2015 = 100. Chips show the annual rate; tap to hide a series.</div>
          <div class="chips" id="cpi-chips"></div>
          <div class="chart" id="ch-cpi"></div>
          <p class="src">Source: ONS Consumer Price Inflation (September 2026), series D7BT, D7G8 and MM23 components.</p>
        </article>
        <aside class="poll" id="poll-wageup"></aside>
      </div>
    </div>

    <!-- GROWTH -->
    <div class="tabpanel hidden" id="tab-growth" role="tabpanel">
      <div class="row">
        <article class="panel ind">
          <h3>The <span style="color:var(--lime)">economy</span> is growing more slowly than it did before 2008</h3>
          <div class="sub">Real GDP, chained volume measure, £bn a quarter</div>
          <div class="split" style="margin-top:12px">
            <div class="chart" id="ch-gdp"></div>
            <div><h4>Average growth a year</h4><div id="pb-gdp"></div></div>
          </div>
          <p class="src">Source: ONS Quarterly National Accounts (September 2026). Series ABMI.</p>
        </article>
        <aside class="poll empty" id="poll-g1"></aside>
      </div>
      <div class="row">
        <article class="panel ind">
          <h3><span style="color:var(--lime)">Output per worker</span> is growing again, from a low base</h3>
          <div class="sub">GVA per worker, index 2023 = 100</div>
          <div class="split" style="margin-top:12px">
            <div class="chart" id="ch-prod"></div>
            <div><h4>Average growth a year</h4><div id="pb-prod"></div></div>
          </div>
          <p class="src">Notes: RTI-based measure, as recommended by ONS. Source: ONS Productivity flash estimate (August 2026). Series A4YM.</p>
        </article>
        <aside class="poll empty" id="poll-g2"></aside>
      </div>
      <div class="row">
        <article class="panel ind">
          <h3><span style="color:var(--lime)">Housebuilding starts</span> are recovering, but remain well below their 2023 peak</h3>
          <div class="sub">New build dwellings started, England, rolling 12-month total</div>
          <div class="stats" id="st-starts"></div>
          <div class="chart" id="ch-starts"></div>
          <p class="src">Notes: Dots are published figures; straight lines join them. Latest quarter: 35,910 starts in April to June 2026, seasonally adjusted. The 2023 peak and trough reflect starts brought forward ahead of new building regulations. Source: MHCLG Housing supply: indicators of new supply, England (June and September 2026).</p>
        </article>
        <aside class="poll empty" id="poll-g3"></aside>
      </div>
    </div>
  </section>

  <!-- REGIONAL -->
  <aside class="panel regional" aria-label="Good growth by area">
    <h2>Good growth where you live</h2>
    <div class="search">
      <input id="q1" list="laList" placeholder="Search for a council, e.g. Hounslow" aria-label="Search for a local authority">
      <button data-go="q1">Find</button>
    </div>
    <div class="mapbox" id="miniMap"><div class="mapmsg">Loading local authority boundaries</div></div>
    <div class="cycler">
      <button data-step="-1" aria-label="Previous indicator">&#8249;</button>
      <div class="cn"><b class="indName"></b><span class="indDesc"></span></div>
      <button data-step="1" aria-label="Next indicator">&#8250;</button>
    </div>
    <div class="legend" id="legMini"></div>
    <div class="selcard" id="selMini"></div>
    <button class="explore-btn" id="openExplore">Explore every indicator by area</button>
  </aside>
</main>
<datalist id="laList"></datalist>

<div class="explore hidden" id="explore" role="dialog" aria-modal="true" aria-label="Explore good growth by area">
  <div class="ex-top">
    <button class="ex-close" id="closeExplore">Back to national view</button>
    <h2>Good growth by area</h2>
