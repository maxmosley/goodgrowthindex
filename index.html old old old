const state={i:0,sel:null,feats:[],by:{},la:{}};
const GREENS=d3.quantize(d3.interpolateRgbBasis(['#1d4a50','#00A787','#9be6d3']),6);
const BLUES=d3.quantize(d3.interpolateRgbBasis(['#24456e','#2361B4','#99ACFF']),5);
const OVR={E09000001:{gva:950000,prod:190000,pay:1050},E09000033:{gva:310000,prod:150000},E09000007:{gva:145000},E09000030:{gva:92000},E09000019:{gva:90000},E09000028:{gva:70000},E09000022:{gva:52000}};
const BOOST=['Reading','Slough','Milton Keynes','Aberdeen City','Edinburgh','City of Edinburgh','Manchester','Leeds','Cambridge','Oxford','Bristol','Bristol, City of','Watford','Guildford','South Cambridgeshire','Wokingham','Trafford','Glasgow City','Cardiff','Belfast','Hounslow','Hillingdon','Southampton','Warrington','Swindon','Basingstoke and Deane'];

// Approximate starts per 1,000 dwellings by region, 2024-25 (MHCLG regional totals and dwelling stock; devolved figures approximate)
const START_RATE={NE:5.9,NW:3.8,YH:3.8,EM:6.3,WM:3.9,EE:6.2,LDN:1.1,SE:5.8,SW:5.3,WAL:2.8,SCO:5.6,NI:6.7};
// Areas with large Building Safety Regulator starts in 2025 and 2026 (MHCLG technical notes)
const BUILD=['Manchester','Newcastle upon Tyne','Bristol, City of','Salford','Tower Hamlets','Greenwich','Ealing','Brent','Newham','Leeds','Birmingham'];
function regionOf(code,lon,lat){
  if(code[0]==='W')return'WAL';if(code[0]==='S')return'SCO';if(code[0]==='N')return'NI';if(code.startsWith('E09'))return'LDN';
  if(lat>54.45&&lon>-2.75)return'NE';
  if(lat>53.3)return lon<-2.05?'NW':'YH';
  if(lat>52.35)return lon<-1.65?'WM':(lon>0.15&&lat<52.9?'EE':'EM');
  if(lon<-1.9)return lat>52.0?'WM':'SW';
  if(lat>51.55&&lon>-0.75)return'EE';
  return'SE';
}
function genLA(f){
  const r=rng(hash(f.code)),n=()=>(r()+r()+r()-1.5)/1.5;
  const [lon,lat]=d3.geoCentroid(f);
  const lon_=f.code[0]==='N'?-6:lon;
  let p=Math.max(-1,Math.min(1,(52.6-lat)/2.2))*(lon_>-3.2?1:.4)+(f.code.startsWith('E09')?.55:0)+(BOOST.includes(f.name)?.45:0)+n()*.35;
  if(f.code[0]==='S'&&lat<56.2&&lat>55.8)p+=.2;
  const ldn=f.code.startsWith('E09');
  const o={
    gva:26500*Math.exp(.38*p+n()*.12)*(ldn?1.25:1),
    unemp:Math.max(1.8,Math.min(9.8,4.7-1.1*p+n()*1.1+(ldn?2.1:0))),
    vac:-16+7*p+n()*7,
    wage:.8+.6*p+n()*.9,
    pay:Math.round(700+110*p+n()*45+(ldn?120:0)),
    gdp:1.3+.7*p+n()*1.4,
    prod:Math.round(64000*Math.exp(.22*p+n()*.08)*(ldn?1.2:1)),
    starts:Math.max(.2,START_RATE[regionOf(f.code,lon,lat)]*Math.exp(n()*.6)*(BUILD.includes(f.name)?1.9:1))
  };
  o.uv=Math.max(.8,Math.min(6,o.unemp/(1.9+.35*p+n()*.2)));
  Object.assign(o,OVR[f.code]||{});
  return o;
}

const SOURCES=[
 './lad_boundaries.geojson',
 'https://services1.arcgis.com/ESMARspQHYMw9BZ9/arcgis/rest/services/LAD_MAY_2025_UK_BUC/FeatureServer/0/query?where=1%3D1&outFields=*&outSR=4326&f=geojson',
 'https://services1.arcgis.com/ESMARspQHYMw9BZ9/arcgis/rest/services/LAD_DEC_2024_UK_BUC/FeatureServer/0/query?where=1%3D1&outFields=*&outSR=4326&f=geojson',
 'https://services1.arcgis.com/ESMARspQHYMw9BZ9/arcgis/rest/services/Local_Authority_Districts_May_2024_Boundaries_UK_BUC/FeatureServer/0/query?where=1%3D1&outFields=*&outSR=4326&f=geojson'
];
function rewind(f){const g=f.geometry;if(!g)return;const fix=poly=>{if(d3.geoArea({type:'Polygon',coordinates:poly})>2*Math.PI)poly.forEach(r=>r.reverse())};
  if(g.type==='Polygon')fix(g.coordinates);else if(g.type==='MultiPolygon')g.coordinates.forEach(fix)}
async function loadBoundaries(){
  for(const u of SOURCES){
    try{const res=await fetch(u);if(!res.ok)continue;const gj=await res.json();if(!gj.features||gj.features.length<300)continue;
      return gj.features.map(f=>{const pr=f.properties||{};const ck=Object.keys(pr).find(k=>/^LAD\d{2}CD$/i.test(k)),nk=Object.keys(pr).find(k=>/^LAD\d{2}NM$/i.test(k));
        const ft={type:'Feature',geometry:f.geometry,properties:pr,code:pr[ck],name:pr[nk]};rewind(ft);return ft}).filter(f=>f.code&&f.geometry)}
    catch(e){}
  }
  return null;
}

// Map rule: values above 0 are green, values below 0 are blue. Brighter means further from zero.
function scaleFor(ind){
  const vals=state.feats.map(f=>state.la[f.code][ind.k]);
  const pos=vals.filter(v=>v>=0),neg=vals.filter(v=>v<0);
  const g=pos.length?d3.scaleQuantile().domain(pos).range(GREENS):null;
  const b=neg.length?d3.scaleQuantile().domain(neg.map(Math.abs)).range(BLUES):null;
  const f=v=>v<0?b(Math.abs(v)):g(v);f.hasNeg=neg.length>0;f.hasPos=pos.length>0;return f}
function rankOf(ind,code){const s=[...state.feats].sort((a,b)=>ind.hi?state.la[b.code][ind.k]-state.la[a.code][ind.k]:state.la[a.code][ind.k]-state.la[b.code][ind.k]);return s.findIndex(f=>f.code===code)+1}
function ordinal(n){const s=['th','st','nd','rd'],v=n%100;return n+(s[(v-20)%10]||s[v]||s[0])}

function makeMap(host){
  host.innerHTML='';
  const svg=d3.select(host).append('svg');const g=svg.append('g');let path,W,H;
  const zoom=d3.zoom().scaleExtent([1,40]).on('zoom',e=>g.attr('transform',e.transform));
  svg.call(zoom).on('dblclick.zoom',null);
  const ctl=d3.select(host).append('div').attr('class','mapctl');
  ctl.append('button').attr('aria-label','Zoom in').text('+').on('click',()=>svg.transition().call(zoom.scaleBy,1.6));
  ctl.append('button').attr('aria-label','Zoom out').text('−').on('click',()=>svg.transition().call(zoom.scaleBy,1/1.6));
  ctl.append('button').attr('aria-label','Reset view').text('⟲').on('click',()=>svg.transition().duration(600).call(zoom.transform,d3.zoomIdentity));
  function draw(){W=host.clientWidth;H=host.clientHeight;if(!W||!H)return;svg.attr('viewBox',`0 0 ${W} ${H}`);
    const proj=d3.geoTransverseMercator().rotate([2,0]).fitExtent([[8,8],[W-8,H-8]],{type:'FeatureCollection',features:state.feats});
    path=d3.geoPath(proj);
    g.selectAll('path').data(state.feats,d=>d.code).join('path').attr('d',path)
      .on('mousemove',(e,d)=>{const ind=IND[state.i];showTT(e,`<b>${d.name}</b>${ind.n}: ${ind.f(state.la[d.code][ind.k])}`)})
      .on('mouseleave',hideTT).on('click',(e,d)=>select(d.code));
    recolor();if(state.sel)highlight(false);
  }
  function recolor(){const ind=IND[state.i],sc=scaleFor(ind);g.selectAll('path').attr('fill',d=>sc(state.la[d.code][ind.k]))}
  function highlight(zoomTo=true){g.selectAll('path').classed('sel',d=>d.code===state.sel);g.selectAll('path.sel').raise();
    if(zoomTo&&state.sel&&path){const f=state.by[state.sel];const[[x0,y0],[x1,y1]]=path.bounds(f);
      const kFit=.9/Math.max((x1-x0)/W,(y1-y0)/H);const k=Math.max(1.6,Math.min(10,kFit/4));
      svg.transition().duration(800).call(zoom.transform,d3.zoomIdentity.translate(W/2,H/2).scale(k).translate(-(x0+x1)/2,-(y0+y1)/2))}}
  return{draw,recolor,highlight};
}

