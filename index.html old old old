  try{
    const url=await htmlToImage.toPng(p,{pixelRatio:2,
      filter:n=>!(n.classList&&(n.classList.contains('dl')||n.classList.contains('mapctl')||n.classList.contains('explore-btn')||n.classList.contains('search')||(n.dataset&&n.dataset.step)))});
    const a=document.createElement('a');a.href=url;a.download='ggf-'+name+'.png';document.body.appendChild(a);a.click();a.remove();
  }catch(e){alert('The image could not be saved. Try again, or take a screenshot instead.')}
  p.classList.remove('exporting');btn.disabled=false;
}
